{
  "name": "lily-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web dashboard served by lily at / (Vue 3 + Vite + TypeScript)",
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vue-tsc --noEmit && vite build",
    "build:mock": "vue-tsc --noEmit && vite build --mode mock --outDir dist-mock",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "check:dist": "npm run build && git diff --exit-code -- dist && test -z \"$(git ls-files --others --exclude-standard -- dist)\""
  },
  "dependencies": {
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/shippori-mincho": "5.3.0",
    "@types/node": "24.19.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.11"
  }
}
